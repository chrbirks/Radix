<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; the platform theme only needs to stay out
         of the way (no action bar, dark ground so the first frame doesn't flash). -->
    <style name="Theme.Radix" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#F5F7F6</item>
        <item name="android:statusBarColor">#F5F7F6</item>
        <item name="android:navigationBarColor">#F5F7F6</item>
    </style>
</resources>
